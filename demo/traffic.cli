# Live-demo traffic. At the mininet> prompt type:   source demo/traffic.cli
# (start topology.py from the project folder so the hosts find the scripts)
#
# Timeline (seconds after you press Enter):
#   0   receiver on h4 starts; voice (h1) and video (h2) start: 3.5 Mbps, no congestion
#   15  bulk (h3) joins at 20 Mbps: the 10 Mbps link congests, the controller switches to qos
#   60  bulk stops: congestion clears, the controller switches back to flat
#   90  voice and video stop
#   100 receiver stops and writes /tmp/rx.log and /tmp/demo.json
#
# Mininet strips everything after a hash sign, so command lines must not contain one.
h4 python3 udp_receiver.py --duration 100 --out /tmp/demo.json --label demo > /tmp/rx.log 2>&1 &
h1 python3 udp_sender.py --class voice --dst 10.0.0.4 --duration 90 > /tmp/voice.log 2>&1 &
h2 python3 udp_sender.py --class video --dst 10.0.0.4 --duration 90 > /tmp/video.log 2>&1 &
h3 python3 udp_sender.py --class bulk --dst 10.0.0.4 --start-delay 15 --duration 45 > /tmp/bulk.log 2>&1 &
